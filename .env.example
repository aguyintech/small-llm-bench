# Copy to .env and edit. Every variable is optional; the values below are the
# defaults unless noted. Full list: docs/cli.md#configuration

# --- Model under test (sllmb run) ---
BENCH_ENDPOINT=http://localhost:11434/v1
BENCH_MODEL=qwen3:8b
# Bearer token, if your endpoint needs one.
BENCH_API_KEY=
# 1 is what the reference fleet used (the default is 2). Decode speed depends
# on batching, so speed numbers only compare at equal concurrency.
BENCH_CONCURRENCY=1
# pass^3, the published headline, needs 3.
BENCH_TRIALS=1
# Base seed, offset per trial. -1 sends no seed.
BENCH_SEED=0
# Uncomment to send these; left unset, the server's own defaults apply.
# BENCH_TEMPERATURE=0.7
# BENCH_THINKING=true
BENCH_OUTPUT_DIR=./results

# --- Timeouts ---
# FLOOR for the per-request read timeout, not the whole budget. The real value
# is derived from each request's own max_tokens as
# cap / BENCH_MIN_GENERATION_TOK_S + BENCH_PREFILL_ALLOWANCE, because one flat
# number cannot serve both a 12k-token request on a slow model and a short one
# on a fast model.
BENCH_TIMEOUT=60
# Connect briefly and separately, so a dead endpoint fails in seconds even
# while a legitimate generation is allowed ten minutes.
BENCH_CONNECT_TIMEOUT=10
# Throughput floor for the derivation: the slowest model on the reference
# fleet sustained about 20 tok/s.
BENCH_MIN_GENERATION_TOK_S=20
BENCH_PREFILL_ALLOWANCE=120
BENCH_MAX_ATTEMPTS=3
BENCH_RETRY_BACKOFF=1.0
# Abort the run if the first N trials to finish ALL come back empty (dead
# endpoint, wrong model id, no tool API). 0 disables.
BENCH_SANITY_CHECK_AFTER=3

# Every module sets its own completion cap, so this fallback only applies to a
# task without one. Use `sllmb run --max-tokens` to override the caps.
BENCH_MAX_TOKENS=8192

# --- Code sandbox ---
# auto | docker | podman | bwrap | sandbox-exec | rlimit
BENCH_SANDBOX_BACKEND=auto
BENCH_SANDBOX_MEMORY_MB=256

# --- LLM judge (sllmb judge) — optional ---
JUDGE_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai
JUDGE_MODEL=gemini-2.5-flash
# Gemini API key from https://aistudio.google.com/apikey
JUDGE_API_KEY=
JUDGE_CONCURRENCY=4

# --- Candidate-task probe loop (sllmb probe) — for task authors ---
# The trio a candidate task is screened against, in DECLARED weak-to-strong
# order. The verdict never re-sorts this: an order derived from the data
# cannot detect a task that ranks models backwards.
PROBE_MODELS=qwen3.5-4b,gemma-4-12b,qwen3.6-27b
# Scratch root. Gitignored, and a probe never writes into results/.
PROBE_DIR=.scratch/probe
PROBE_TRIALS=3
# Hard cap on scoring cycles per construct. INVALID cycles do not count.
PROBE_MAX_CYCLES=3
PROBE_CYCLE_TIMEOUT=600
